[sub_resource type="GDScript" id="GDScript_dix8h"]
script/source = "extends Camera2D

@onready var target := $\"..\"

func _ready() -> void:
	enabled = true

func _process(delta: float) -> void:
	if is_instance_valid(target):
		
		if \"player_dead\" in target and target.player_dead:
			set_process(false)
			return
"

