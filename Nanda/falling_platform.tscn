[sub_resource type="GDScript" id="GDScript_3bnor"]
script/source = "extends StaticBody2D

# a platform that gives way once the player stands on it - shakes for a moment as a warning,
# then drops out (collision disabled, sprite hidden) so they fall through. can either respawn
# after a delay (for a repeatable trap) or stay gone for good (for a one-way route you're not
# meant to climb back up through).

@export var shake_time: float = 0.5 # warning delay between stepping on it and it giving way
@export var respawns: bool = true # false = gone for good the first time it drops
@export var respawn_delay: float = 2.0 # how long it stays gone before resetting, if it respawns

@onready var _sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var _collision: CollisionShape2D = $CollisionShape2D
@onready var _trigger: Area2D = $TriggerArea

var _triggered: bool = false

func _ready() -> void:
	_trigger.body_entered.connect(_on_trigger_body_entered)

func _on_trigger_body_entered(body: Node) -> void:
	if _triggered or not body.is_in_group(\"player\"):
		return
	_triggered = true
	_sprite.play(\"shake\")
	get_tree().create_timer(shake_time).timeout.connect(_fall)

func _fall() -> void:
	_collision.set_deferred(\"disabled\", true)
	_trigger.set_deferred(\"monitoring\", false)
	_sprite.visible = false

	if respawns:
		get_tree().create_timer(respawn_delay).timeout.connect(_reset)

func _reset() -> void:
	_triggered = false
	_collision.set_deferred(\"disabled\", false)
	_trigger.monitoring = true
	_sprite.visible = true
	_sprite.play(\"idle\")
"

